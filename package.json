{
  "name": "gravton-chatbot-gemini",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:live": "node --import tsx tests/live.ts",
    "zip": "node scripts/package.mjs",
    "setup": "node scripts/setup.mjs",
    "knowledge:check": "node --import tsx scripts/check-knowledge.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
